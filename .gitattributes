# =============================================================================
#  .gitattributes — Cámara de Gesell (Unity 6 · UTPL XRlab)
#  Requisito en cada PC:  git lfs install   (una sola vez por usuario)
#  Los patrones usan [Aa] para cubrir mayúsculas/minúsculas (p. ej. .FBX)
# =============================================================================

# ---- Normalización de fin de línea ------------------------------------------
* text=auto

# Código y texto
*.cs        text diff=csharp eol=lf
*.shader    text eol=lf
*.cginc     text eol=lf
*.hlsl      text eol=lf
*.compute   text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.asmdef    text eol=lf
*.asmref    text eol=lf

# Archivos YAML de Unity (Force Text). Se tratan como texto, sin diff de ruido.
# merge=unityyamlmerge sólo actúa si se configura UnityYAMLMerge (ver STUDY_NOTES);
# si no está configurado, Git usa su merge de texto normal.
*.meta              text eol=lf -diff
*.unity             text eol=lf merge=unityyamlmerge linguist-generated
*.prefab            text eol=lf merge=unityyamlmerge linguist-generated
*.asset             text eol=lf merge=unityyamlmerge linguist-generated
*.mat               text eol=lf merge=unityyamlmerge linguist-generated
*.anim              text eol=lf merge=unityyamlmerge linguist-generated
*.controller        text eol=lf merge=unityyamlmerge linguist-generated
*.overrideController text eol=lf merge=unityyamlmerge linguist-generated
*.mask              text eol=lf merge=unityyamlmerge linguist-generated
*.playable          text eol=lf merge=unityyamlmerge linguist-generated
*.physicMaterial    text eol=lf merge=unityyamlmerge linguist-generated
*.lighting          text eol=lf merge=unityyamlmerge linguist-generated
*.spriteatlas       text eol=lf merge=unityyamlmerge linguist-generated
*.signal            text eol=lf merge=unityyamlmerge linguist-generated

# ---- Git LFS: Modelos 3D -----------------------------------------------------
*.[Ff][Bb][Xx]      filter=lfs diff=lfs merge=lfs -text
*.[Oo][Bb][Jj]      filter=lfs diff=lfs merge=lfs -text
*.[Bb][Ll][Ee][Nn][Dd] filter=lfs diff=lfs merge=lfs -text
*.[Dd][Aa][Ee]      filter=lfs diff=lfs merge=lfs -text
*.3[Dd][Ss]         filter=lfs diff=lfs merge=lfs -text
*.[Gg][Ll][Bb]      filter=lfs diff=lfs merge=lfs -text
*.[Mm][Aa][Xx]      filter=lfs diff=lfs merge=lfs -text
*.[Mm][Bb]          filter=lfs diff=lfs merge=lfs -text

